		  private int handleAEIOUY(String value, int i)
		   {
		       //...............................................................................................
			   if (i == 0) // we are at the first character
		        {
		             if (charAt(value,i) == 'A' || charAt(value,i) == 'E' || charAt(value,i) == 'I')
		             {
			        	  this.encodeString = this.encodeString + 'A';
		              i = (charAt(value, i + 1) == 'A' || charAt(value, i + 1) == 'E' || charAt(value, i + 1) == 'I') ? i + 2 : i + 1;
		             }
		             else 
		             
		                 if (charAt(value, i) == 'U' || charAt(value, i) == 'O')
				            { 
		            	          this.encodeString = this.encodeString + 'U';
					          i = (charAt(value, i + 1) == 'U' || charAt(value, i + 1) == 'O') ? i + 2 : i + 1;
				             }
		             return i;      
		        } // i==0 chk end
			   //...............................................................................................
			   if (i == value.length() - 1 ) // we are at the last character 
			   {
				      if (charAt(value,i) == 'A')
				      {
				    	  this.encodeString = this.encodeString + 'A';
				          i = i + 1;
				          return i;
				      }
				      if (charAt(value,i) == 'E' || charAt(value, i) == 'I')
				      {
				    	  this.encodeString = this.encodeString + 'I';
				          i = i + 1;
				          return i;
				      }
				      if (charAt(value,i) == 'O' || charAt(value, i) == 'U')
				      {
				    	  this.encodeString = this.encodeString + 'U';
				          i = i + 1;
				          return i;
				      }
			   }
				
			   else // we are anywhere from 2nd character to 2nd last. here previous and next character matters
			   { 	      
		          /*
				   if (charAt(value, i) == 'I' || charAt(value, i) == 'E')
	                 {
	   	        	   		this.encodeString = (charAt(encodeString,encodeString.length()-1) == 'I') ? this.encodeString : this.encodeString + 'I';
	   	        	   		i = (charAt(value, i + 1) == 'I' || charAt(value, i + 1) == 'E') ? i + 2 : i + 1;
	   	        	   		return i; 
	                 }
		           else
		            */
				   if (i == value.length() - 2 ) // we are at 2nd last character and next is H
			         {
					   if (charAt(value, value.length() - 1) == 'H' && charAt(value, value.length() - 2) == 'A') 
					   { 
						   this.encodeString += 'A';  
						   ++i;
					   }
					   if (charAt(value, value.length() - 1) == 'M' && charAt(value, value.length() - 2) == 'A') 
					   { 
						   this.encodeString += 'M';  
						   return ++i;
					   }
					   
				     }
				   if (charAt(value, i) == 'U' || charAt(value, i) == 'O')
			         {
					   this.encodeString = (charAt(encodeString,encodeString.length()-1) == 'U' || charAt(encodeString,encodeString.length()-1) == 'H') ? this.encodeString : this.encodeString + 'U';
				      i = (charAt(value, i + 1) == 'U' || charAt(value, i + 1) == 'O') ? i + 2 : i + 1;
				      return i;  
			         }
		    	     //..................................new case.............................
				   if (charAt(value,i) == 'I' && charAt(value,i+1) == 'A') // make it Y
				   {
